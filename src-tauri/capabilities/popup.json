{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "popup",
  "description": "Quick-note and sticky pop-out windows: minimal window controls only.",
  "windows": ["quicknote", "sticky-*"],
  "permissions": [
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus"
  ]
}
